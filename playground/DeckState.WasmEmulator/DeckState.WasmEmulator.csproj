<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- No native dependency any more: the renderer emits SVG directly, so plain IL-interpreted
         Blazor WASM is enough. No wasm-tools workload, no Emscripten, no reboot. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- The REAL system: same Core + StreamDeck rendering the device plugin uses. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DeckState.Core\DeckState.Core.csproj" />
    <ProjectReference Include="..\..\src\DeckState.StreamDeck\DeckState.StreamDeck.csproj" />
  </ItemGroup>

  <!-- The REAL ReadyDeck logic, compiled straight from the sample source (no reimplementation). -->
  <ItemGroup>
    <Compile Include="..\..\Samples\ReadyDeck\DeckState.ReadyDeckPlugin\ReadyDeckPlugin.cs" Link="ReadyDeck\ReadyDeckPlugin.cs" />
    <Compile Include="..\..\Samples\ReadyDeck\DeckState.ReadyDeckPlugin\ReadyDeckContext.cs" Link="ReadyDeck\ReadyDeckContext.cs" />
    <Compile Include="..\..\Samples\ReadyDeck\DeckState.ReadyDeckPlugin\ReadyDeckRuntime.cs" Link="ReadyDeck\ReadyDeckRuntime.cs" />
    <Compile Include="..\..\Samples\ReadyDeck\DeckState.ReadyDeckPlugin\ReadyButtonKey.cs" Link="ReadyDeck\ReadyButtonKey.cs" />
    <Compile Include="..\..\Samples\ReadyDeck\DeckState.ReadyDeckPlugin\ReadyCountSpinnerKey.cs" Link="ReadyDeck\ReadyCountSpinnerKey.cs" />
  </ItemGroup>

</Project>
