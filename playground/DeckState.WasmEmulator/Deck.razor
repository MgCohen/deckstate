@implements IAsyncDisposable
@inject IJSRuntime Js
@using System.Text.Json
@using DeckState.StreamDeck
@using DeckState.WasmEmulator.Emulator

<div class="app">
  <div class="bar">
    <div class="group">
      <label for="project">Project</label>
      <select id="project" value="@_project.Name" @onchange="OnProjectChanged">
        @foreach (var project in EmulatorProjects.All)
        {
          <option value="@project.Name">@project.Name</option>
        }
      </select>
    </div>
    <div class="group">
      <label for="device">Device</label>
      <select id="device" value="@_device.Name" @onchange="OnDeviceChanged">
        @foreach (var device in DeckDevice.All)
        {
          <option value="@device.Name">@device.Name (@device.Columns×@device.Rows)</option>
        }
      </select>
    </div>
    <div class="spacer"></div>
    <button class="btn @(_configuring ? "on" : null)" @onclick="ToggleConfigure">
      @(_configuring ? "Done" : "Configure")
    </button>
    @if (_configuring)
    {
      <button class="btn" @onclick="ResetLayoutAsync">Reset layout</button>
    }
  </div>

  <div class="deck @(_configuring ? "cfg" : null)">
    <div class="deck-grid" style="grid-template-columns:repeat(@_device.Columns, 72px);">
      @for (var slot = 0; slot < _device.KeyCount; slot++)
      {
        var index = slot;
        var context = ContextFor(index);
        var assigned = _layout.TryGetValue(index, out var actionId);
        var svg = _svgByContext.GetValueOrDefault(context);
        var pressable = !_configuring && assigned;

        <button class="k @(assigned ? "assigned" : "empty") @(pressable ? "pressable" : null)"
                @onclick="() => OnKeyClickAsync(index)">
          @if (svg is not null)
          {
            @(new MarkupString(svg))
          }
          else if (!assigned)
          {
            <span class="plus">@(_configuring ? "+" : "")</span>
          }
          @if (_configuring)
          {
            <span class="badge">@(assigned ? _project.ActionById(actionId)?.ShortLabel : "empty")</span>
          }
        </button>
      }
    </div>
  </div>

  <p class="hint">
    @if (_configuring)
    {
      <span>Click a key to cycle it through this project's actions and back to empty.</span>
    }
    else
    {
      <span>The real <code>@_project.Name</code> plugin loop, compiled to WebAssembly. Click a key to send a serialized <code>keyDown</code>.</span>
    }
  </p>
</div>

@code {
    private EmulatorProject _project = EmulatorProjects.All[0];
    private DeckDevice _device = DeckDevice.Standard;
    private bool _configuring;

    private readonly Dictionary<int, string> _layout = new();
    private readonly Dictionary<string, string> _svgByContext = new(StringComparer.Ordinal);

    private JsBridgeTransport? _transport;
    private CancellationTokenSource? _cts;
    private Task _host = Task.CompletedTask;
    private bool _renderPending;

    private static string ContextFor(int slot) => $"slot-{slot}";

    protected override async Task OnInitializedAsync()
    {
        ApplyDefaultLayout();
        await StartAsync();
    }

    private void ApplyDefaultLayout()
    {
        _layout.Clear();
        foreach (var (slot, actionId) in _project.DefaultLayout(_device))
            if (slot < _device.KeyCount)
                _layout[slot] = actionId;
    }

    // Start the real plugin loop over a fresh in-process transport, then announce the configured keys.
    private Task StartAsync()
    {
        var transport = new JsBridgeTransport();
        transport.Frame += OnFrame;
        var cts = new CancellationTokenSource();
        _transport = transport;
        _cts = cts;

        var run = _project.CreateRun(Js, _device.Columns);
        _host = StreamDeckPluginHost.RunAsync(
            transport,
            new StreamDeckPluginArguments(0, "deckstate-emulator", "registerPlugin"),
            run,
            cts.Token);

        // The real host sends action-less frames (deviceDidConnect) before any willAppear.
        // Deliver one here so the emulator exercises the same loop path hardware does — a plugin
        // that mishandles a frame without an "action" field must fail in the emulator too.
        transport.Deliver(DeviceDidConnect());

        foreach (var (slot, actionId) in _layout.OrderBy(entry => entry.Key))
            transport.Deliver(WillAppear(actionId, ContextFor(slot), slot));

        return Task.CompletedTask;
    }

    private async Task StopAsync()
    {
        if (_transport is null || _cts is null) return;
        _transport.Frame -= OnFrame;
        _cts.Cancel();
        try { await _host; } catch (OperationCanceledException) { } catch (JsonException) { }
        await _transport.DisposeAsync();
        _cts.Dispose();
        _transport = null;
        _cts = null;
        _host = Task.CompletedTask;
        _svgByContext.Clear();
    }

    private async Task ReconfigureAsync()
    {
        await StopAsync();
        await StartAsync();
        StateHasChanged();
    }

    private async Task OnProjectChanged(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        var next = EmulatorProjects.All.FirstOrDefault(p => p.Name == name);
        if (next is null || ReferenceEquals(next, _project)) return;
        _project = next;
        ApplyDefaultLayout();
        await ReconfigureAsync();
    }

    private async Task OnDeviceChanged(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        var next = DeckDevice.All.FirstOrDefault(d => d.Name == name);
        if (next is null || ReferenceEquals(next, _device)) return;
        _device = next;
        ApplyDefaultLayout();
        await ReconfigureAsync();
    }

    private void ToggleConfigure() => _configuring = !_configuring;

    private async Task ResetLayoutAsync()
    {
        ApplyDefaultLayout();
        await ReconfigureAsync();
    }

    private async Task OnKeyClickAsync(int slot)
    {
        if (_configuring)
        {
            CycleAssignment(slot);
            await ReconfigureAsync();
            return;
        }

        if (_transport is not null && _layout.TryGetValue(slot, out var actionId))
            _transport.Deliver(KeyDown(actionId, ContextFor(slot), slot));
    }

    // Cycle a key: empty -> action[0] -> action[1] -> ... -> empty.
    private void CycleAssignment(int slot)
    {
        var options = new List<string?> { null };
        options.AddRange(_project.Actions.Select(a => a.ActionId));
        var current = _layout.GetValueOrDefault(slot);
        var next = options[(options.IndexOf(current) + 1) % options.Count];
        if (next is null) _layout.Remove(slot); else _layout[slot] = next;
    }

    private void OnFrame(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (!root.TryGetProperty("event", out var ev) || ev.GetString() != "setImage") return;
            if (!root.TryGetProperty("context", out var ctx)) return;
            if (!root.TryGetProperty("payload", out var payload) || !payload.TryGetProperty("image", out var img)) return;

            var image = img.GetString();
            const string prefix = "data:image/svg+xml,";
            if (image is null || !image.StartsWith(prefix, StringComparison.Ordinal)) return;

            _svgByContext[ctx.GetString()!] = Uri.UnescapeDataString(image[prefix.Length..]);
            RequestRender();
        }
        catch (JsonException) { /* ignore malformed frames */ }
    }

    private void RequestRender()
    {
        if (_renderPending) return;
        _renderPending = true;
        _ = InvokeAsync(() =>
        {
            _renderPending = false;
            StateHasChanged();
        });
    }

    private string WillAppear(string action, string context, int slot) => Frame(action, context, slot, "willAppear");
    private string KeyDown(string action, string context, int slot) => Frame(action, context, slot, "keyDown");

    // Action-less frame the host sends on connect; carries no "action"/"context". The plugin loop must skip it.
    private string DeviceDidConnect() => JsonSerializer.Serialize(new
    {
        @event = "deviceDidConnect",
        device = "deckstate-emulator-device",
        deviceInfo = new { name = _device.Name, type = 0 }
    });

    private string Frame(string action, string context, int slot, string @event) => JsonSerializer.Serialize(new
    {
        action,
        context,
        @event,
        payload = new { coordinates = new { row = slot / _device.Columns, column = slot % _device.Columns }, settings = new { } }
    });

    public async ValueTask DisposeAsync() => await StopAsync();
}
